# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.

# AI assistant (option 1, free, no card): Google Gemini key from
# https://aistudio.google.com/apikey. Takes priority when set.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional Gemini model, default gemini-flash-lite-latest (the free tier allows far more
# requests per day than gemini-flash-latest)
GEMINI_MODEL=

# AI assistant (option 2) — Vercel AI Gateway key (https://vercel.com/ai-gateway).
# Not needed on Vercel deployments: the gateway authenticates automatically.
AI_GATEWAY_API_KEY=

# Optional: any AI Gateway model id, e.g. openai/gpt-5, google/gemini-3-pro
AI_MODEL=anthropic/claude-sonnet-5.5

# Optional: overrides githubUsername in src/data/profile.ts
GITHUB_USERNAME=

# Optional: raises GitHub API rate limits (a fine-grained token with no extra permissions is enough)
GITHUB_TOKEN=

# Contact form + AI lead emails via Resend (https://resend.com/api-keys, free, no card)
RESEND_API_KEY=
# Optional: where inquiries go (default: email in profile.ts). Without a verified domain,
# Resend only delivers to the email address you signed up to Resend with.
CONTACT_TO_EMAIL=
# Optional: sender, needs a domain verified in Resend (default: onboarding@resend.dev)
CONTACT_FROM_EMAIL=

# Optional: your final site URL for SEO (set automatically on Vercel)
NEXT_PUBLIC_SITE_URL=
